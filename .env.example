NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=service_center
DB_HOST=127.0.0.1
DB_PORT=5432
DATABASE_URL="postgresql://postgres:your_password@127.0.0.1:5432/service_center?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

APP_NAME=Service Center API
SEED_ADMIN_EMAIL=admin@servicecenter.com
SEED_ADMIN_PASSWORD=Admin@12345
